generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String   @id @default(cuid())
  name       String
  heritage   String
  suburb     String
  lat        Float
  lng        Float
  bio        String
  avatarSeed String
  avatarData String?
  joinedAt   DateTime @default(now())

  gardenPlants     GardenPlant[]
  stories          Story[]
  listings         Listing[]
  claimedListings  Listing[]     @relation("ClaimedListings")
  growLogs         GrowLog[]
  following        Follow[]      @relation("follower")
  followers        Follow[]      @relation("following")
  sentMessages     Message[]     @relation("sender")
  receivedMessages Message[]     @relation("recipient")
  posts            Post[]
}

model Plant {
  id            String @id @default(cuid())
  commonName    String
  botanicalName String
  origin        String
  category      String
  sunlight      String
  water         String
  season        String
  daysToHarvest Int
  description   String
  imageUrl      String?

  gardenPlants GardenPlant[]
  stories      Story[]
  listings     Listing[]
  growLogs     GrowLog[]
}

model GardenPlant {
  id       String  @id @default(cuid())
  userId   String
  plantId  String
  quantity String
  notes    String?

  user  User  @relation(fields: [userId], references: [id])
  plant Plant @relation(fields: [plantId], references: [id])
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  plantId   String
  title     String
  body      String
  origin    String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  plant Plant @relation(fields: [plantId], references: [id])
}

model Listing {
  id          String   @id @default(cuid())
  userId      String
  plantId     String?
  type        String
  category    String
  title       String
  culture     String
  address     String
  price       Float?
  swapFor     String?
  quantity    String
  imageData   String?
  claimed     Boolean  @default(false)
  claimedById String?
  createdAt   DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id])
  claimedBy User?  @relation("ClaimedListings", fields: [claimedById], references: [id])
  plant     Plant? @relation(fields: [plantId], references: [id])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model GrowLog {
  id        String   @id @default(cuid())
  userId    String
  plantId   String
  day       Int
  note      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  plant Plant @relation(fields: [plantId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  body      String
  createdAt DateTime @default(now())

  from User @relation("sender", fields: [fromId], references: [id])
  to   User @relation("recipient", fields: [toId], references: [id])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  culture   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
